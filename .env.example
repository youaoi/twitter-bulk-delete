# https://console.x.com/ のアプリ画面で表示された値を貼る。
# このファイルはコミットしない。cp .env.example .env してから編集する。

# Keys and tokens の API Key（Consumer Key と表示される場合もある）
X_API_KEY=

# Keys and tokens の API Key Secret（Secret Key / Consumer Secret）
X_API_SECRET=

# Keys and tokens の Access Token。Read and write に変えたあとで発行し直したもの
X_ACCESS_TOKEN=

# Keys and tokens の Access Token Secret
X_ACCESS_TOKEN_SECRET=

# User authentication settings 保存後に表示される OAuth 2.0 Client ID
X_CLIENT_ID=

# User authentication settings 保存後に一度だけ表示される OAuth 2.0 Client Secret
X_CLIENT_SECRET=
